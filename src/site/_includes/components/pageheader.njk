<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

{% if metatags %}
    {% for name, content in metatags %}
        {% if name.includes("og:") %}
          <meta property="{{ name }}" content="{{ content }}">
        {% else %}
          <meta name="{{ name }}" content="{{ content }}">
        {% endif %}
    {% endfor %}
{% endif %}

<script type="importmap">
{
  "imports": {
    "d3-force": "https://cdn.jsdelivr.net/npm/d3-force@3.0.0/+esm",
    "d3-selection": "https://cdn.jsdelivr.net/npm/d3-selection@3.0.0/+esm",
    "d3-zoom": "https://cdn.jsdelivr.net/npm/d3-zoom@3.0.0/+esm",
    "d3-drag": "https://cdn.jsdelivr.net/npm/d3-drag@3.0.0/+esm"
  }
}
</script>
<script src="https://cdn.jsdelivr.net/npm/pixi.js@7.4.2/dist/pixi.min.js"></script>

<script async type="module">
    import mermaid from 'https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs';
    // Disable the library's load handler before waiting for styles.
    mermaid.initialize({ startOnLoad: false, securityLevel: 'strict' });
    // Wait for the body and theme styles, including async module loading.
    if (document.readyState !== 'complete') {
        await new Promise(resolve => window.addEventListener('load', resolve, { once: true }));
    }
    const diagrams = [...document.querySelectorAll('pre.mermaid:not([data-processed])')];
    if (diagrams.length) {
        const probe = document.createElement('span');
        document.body.append(probe);
        const color = (variable, fallback) => {
            probe.style.color = `var(${variable}, ${fallback})`;
            const rgb = getComputedStyle(probe).color.match(/\d+(?:\.\d+)?/g);
            return rgb ? '#' + rgb.slice(0, 3).map(n => Math.round(Number(n)).toString(16).padStart(2, '0')).join('') : fallback;
        };
        const background = color('--background-primary', '#111111');
        const surface = color('--background-secondary', '#202020');
        const text = color('--text-normal', '#dddddd');
        const accent = color('--text-accent', '#55cc88');
        probe.remove();
        mermaid.initialize({
            startOnLoad: false,
            securityLevel: 'strict',
            theme: 'base',
            fontFamily: getComputedStyle(document.body).fontFamily,
            themeVariables: {
                darkMode: document.body.classList.contains('theme-dark'),
                background, primaryColor: surface, primaryTextColor: text,
                primaryBorderColor: accent, secondaryColor: surface,
                secondaryTextColor: text, secondaryBorderColor: accent,
                tertiaryColor: background, tertiaryTextColor: text,
                tertiaryBorderColor: accent, textColor: text,
                lineColor: accent, edgeLabelBackground: background,
                clusterBkg: surface, clusterBorder: accent
            }
        });
        await mermaid.run({ nodes: diagrams });
        const dialog = document.createElement('dialog');
        dialog.className = 'mermaid-dialog';
        dialog.setAttribute('aria-label', '图表原尺寸查看');
        const header = document.createElement('div');
        header.className = 'mermaid-dialog-header';
        const title = document.createElement('span');
        title.textContent = '图表原尺寸查看';
        const close = document.createElement('button');
        close.type = 'button';
        close.textContent = '关闭';
        close.setAttribute('autofocus', '');
        header.append(title, close);
        const detail = document.createElement('div');
        detail.className = 'mermaid-detail';
        dialog.append(header, detail);
        document.body.append(dialog);
        let active = null;
        const open = diagram => {
            if (dialog.open || active) return;
            const svg = diagram.querySelector('svg');
            if (!svg) return;
            const placeholder = document.createComment('Mermaid SVG position');
            active = {
                diagram, svg, placeholder,
                height: diagram.style.height,
                overflow: document.body.style.getPropertyValue('overflow'),
                overflowPriority: document.body.style.getPropertyPriority('overflow')
            };
            diagram.style.height = `${diagram.getBoundingClientRect().height}px`;
            svg.before(placeholder);
            detail.append(svg);
            diagram.setAttribute('aria-expanded', 'true');
            document.body.style.setProperty('overflow', 'hidden');
            dialog.showModal();
            detail.scrollTo(0, 0);
        };
        close.addEventListener('click', () => dialog.close());
        dialog.addEventListener('click', event => {
            const rect = dialog.getBoundingClientRect();
            if (event.target === dialog && (event.clientX < rect.left || event.clientX > rect.right ||
                event.clientY < rect.top || event.clientY > rect.bottom)) dialog.close();
        });
        // Native Escape cancellation also dispatches close, sharing all cleanup.
        dialog.addEventListener('close', () => {
            if (!active) return;
            const { diagram, svg, placeholder, height, overflow, overflowPriority } = active;
            placeholder.replaceWith(svg);
            diagram.style.height = height;
            diagram.setAttribute('aria-expanded', 'false');
            if (overflow) document.body.style.setProperty('overflow', overflow, overflowPriority);
            else document.body.style.removeProperty('overflow');
            active = null;
            diagram.focus({ preventScroll: true });
        });
        diagrams.forEach(diagram => {
            const svg = diagram.querySelector('svg');
            if (!svg?.viewBox.baseVal.width) return;
            svg.style.width = `${svg.viewBox.baseVal.width}px`;
            svg.style.maxWidth = '100%';
            svg.style.height = 'auto';
            diagram.setAttribute('tabindex', '0');
            diagram.setAttribute('role', 'button');
            diagram.setAttribute('aria-label', '图表；点击放大');
            diagram.setAttribute('aria-haspopup', 'dialog');
            diagram.setAttribute('aria-expanded', 'false');
            diagram.addEventListener('click', () => open(diagram));
            diagram.addEventListener('keydown', event => {
                if (event.key === 'Enter' || event.key === ' ') {
                    event.preventDefault();
                    if (!event.repeat) open(diagram);
                }
            });
        });
    }
</script>

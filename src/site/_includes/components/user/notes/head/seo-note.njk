{# Note page SEO: description, OG article, Twitter Card, JSON-LD Article #}
{% set desc = description or meta.siteDescription %}
{% set noteTitle = title or page.fileSlug %}
{% set noteUrl = meta.siteBaseUrl + (page.url | url) %}

<meta name="description" content="{{ desc }}">
<meta property="og:title" content="{{ noteTitle }}">
<meta property="og:description" content="{{ desc }}">
<meta property="og:type" content="article">
<meta property="og:url" content="{{ noteUrl }}">
{% if created %}
<meta property="article:published_time" content="{{ created | dateToZulu }}">
{% endif %}
{% if updated %}
<meta property="article:modified_time" content="{{ updated | dateToZulu }}">
{% endif %}
<meta name="twitter:title" content="{{ noteTitle }}">
<meta name="twitter:description" content="{{ desc }}">

{% if tags %}
<meta name="keywords" content="{{ tags | reject('eq', 'gardenEntry') | reject('eq', 'note') | join(', ') }}">
{% endif %}

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": "{{ noteTitle }}",
  "description": "{{ desc }}",
  "url": "{{ noteUrl }}",
  {% if created %}"datePublished": "{{ created | dateToZulu }}",{% endif %}
  {% if updated %}"dateModified": "{{ updated | dateToZulu }}",{% endif %}
  "author": {
    "@type": "Person",
    "name": "{{ meta.siteName | default('Diomgis') }}"
  }
}
</script>
